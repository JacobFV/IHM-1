{"files": [{"id": 6929198, "name": "MASI_HMaleMuscle_HMaleMassDistr.osim", "size": 631598, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/6929198", "supplied_md5": "ac701736950fc39c2f8dd3f7eddefb9d", "computed_md5": "ac701736950fc39c2f8dd3f7eddefb9d", "mimetype": "text/xml"}, {"id": 6929255, "name": "Figure 1.tif", "size": 903082, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/6929255", "supplied_md5": "53a9ed88f1c81a500b94ae8c8252417f", "computed_md5": "53a9ed88f1c81a500b94ae8c8252417f", "mimetype": "image/tiff"}], "folder_structure": {}, "authors": [{"id": 3358289, "full_name": "Dario Cazzola", "first_name": "Dario", "last_name": "Cazzola", "is_active": true, "url_name": "_", "orcid_id": ""}, {"id": 3358313, "full_name": "Grant Trewartha", "first_name": "Grant", "last_name": "Trewartha", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 3358316, "full_name": "Ezio Preatoni", "first_name": "Ezio", "last_name": "Preatoni", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 3358322, "full_name": "Timothy\u00a0P.\u00a0Holsgrove", "first_name": "Timothy P.", "last_name": "Holsgrove", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 3358319, "full_name": "Harinderjit S.\u00a0Gill", "first_name": "Harinderjit S.", "last_name": "Gill", "is_active": false, "url_name": "_", "orcid_id": ""}], "custom_fields": [], "figshare_url": "https://figshare.com/articles/software/MASI/4249808", "download_disabled": false, "description": "Provides the MASI (.osim) file that can be used in OpenSim.<div><br></div><div>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n<p>The \u2018Musculoskeletal model for the\nAnalysis of Spinal Injury\u2019 (MASI) wascreated in OpenSim (OpenSim\n3.2, Simbios, Stanford, CA, USA) and Matlab software (Matlab 2013b, MathWorks,\nNatick, MA, USA).</p><p>MASI inherited the structure of\nthe OpenSim head and neck model\u00a0(Vasavada Model) which we embedded into a full body model (\u20182354\u2019),\nand was implemented to provide, for the first time, the linkage between\ncervical spine, upper limb, torso and lower limbs.\u00a0</p><p>MASI comprises 35\nrigid anatomical segments, 78 upper and lower cervical muscles divided into 19\nmuscle groups, along with 23 torque actuators representing lower and upper limb\nmuscles\u2019 actions. Motion between body segments was permitted via 34\njoints and 30 kinematic constraints. To incorporate the effect of upper limb\nposition, a new scapula-clavicular joint (SCJ) (combining the joint motions of\nthe acromioclavicular and sternoclavicular joints) was developed and included\nin the MASI, replacing the welded scapula-clavicular joint of the original head\nand neck model. The model had 43 degrees of freedom, though these were reduced\nto 37 by locking the metatarsophalangeal and wrist joints into the neutral\nposition.</p>\n\n</div>", "funding": "RFU Injured Player Foundation", "funding_list": [{"id": 41819, "title": "RFU Injured Player Foundation", "grant_code": "", "funder_name": null, "is_user_defined": 1}], "version": 2, "status": "public", "size": 1534680, "created_date": "2016-11-23T14:04:32Z", "modified_date": "2023-06-02T16:25:58Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 3, "name": "MIT", "url": "https://opensource.org/licenses/MIT"}, "tags": ["modelling", "OpenSim", "Rugby", "Neck", "Shoulder", "Injury Prevention", "Biomechanics", "Musculoskeletal Model", "Biomechanics"], "keywords": ["modelling", "OpenSim", "Rugby", "Neck", "Shoulder", "Injury Prevention", "Biomechanics", "Musculoskeletal Model", "Biomechanics"], "categories": [{"id": 24484, "title": "Clinical microbiology", "parent_id": 24475, "path": "/24457/24475/24484", "source_id": "320203", "taxonomy_id": 100}], "references": ["https://simtk.org/projects/csibath"], "has_linked_file": false, "citation": "Cazzola, Dario; Trewartha, Grant; Preatoni, Ezio; Holsgrove, Timothy P.; Gill, Harinderjit S. (2016). MASI. figshare. Software. https://doi.org/10.6084/m9.figshare.4249808.v2", "related_materials": [{"id": 32283914, "identifier": "https://simtk.org/projects/csibath", "title": "", "relation": "References", "identifier_type": "URL", "is_linkout": false, "link": "https://simtk.org/projects/csibath"}], "is_embargoed": false, "embargo_date": null, "embargo_type": "file", "embargo_title": "", "embargo_reason": "", "embargo_options": [], "id": 4249808, "title": "MASI", "doi": "10.6084/m9.figshare.4249808.v2", "handle": "", "url": "https://api.figshare.com/v2/articles/4249808", "published_date": "2016-11-23T14:04:32Z", "thumb": "https://s3-eu-west-1.amazonaws.com/pfigshare-u-previews/6929255/thumb.png", "defined_type": 9, "defined_type_name": "software", "group_id": null, "url_private_api": "https://api.figshare.com/v2/account/articles/4249808", "url_public_api": "https://api.figshare.com/v2/articles/4249808", "url_private_html": "https://figshare.com/account/articles/4249808", "url_public_html": "https://figshare.com/articles/software/MASI/4249808", "timeline": {"posted": "2016-11-23T14:04:32", "firstOnline": "2016-11-23"}, "resource_title": null, "resource_doi": null}